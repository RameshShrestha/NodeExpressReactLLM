# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Debug and log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt build artifacts
.grunt

# Bower dependency directory
bower_components

# node-gyp output
build/Release

# Code generator directories
.esm-cache
.node-spawn-history

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files (contains passwords/API keys)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build project
.nuxt
dist

# Gatsby files
.gatsby

# Serverless Webpack directories
.webpack/

# Optional compact npm version management file
.node-version
.nvmrc

# Editor specific files (Optional but recommended)
.vscode/
.idea/
.DS_Store
Thumbs.db
